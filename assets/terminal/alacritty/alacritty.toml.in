[general]
import = ["~/.config/alacritty/active-theme.toml", "~/.config/alacritty/keybinds.toml"]
live_config_reload = true

[window]
padding = { x = 10, y = 10 }
opacity = 1.0
decorations = "full"

[font]
normal = { family = @FONT@, style = "Regular" }
size = @FONT_SIZE@

[cursor.style]
shape = "Beam"
blinking = "Never"
